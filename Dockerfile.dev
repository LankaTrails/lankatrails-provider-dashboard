# Development image for the provider dashboard (Vite on port 5174).
# The source is bind-mounted at /app by lankatrails-backend/docker-compose.dev.yml;
# node_modules lives in a container volume so host (macOS) binaries never leak in.
FROM node:22-alpine

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && sha1sum package-lock.json | cut -d' ' -f1 > node_modules/.lock-hash

EXPOSE 5174

# Reinstall only when package-lock.json changed since node_modules was populated.
CMD ["sh", "-c", "h=$(sha1sum package-lock.json | cut -d' ' -f1); if [ \"$(cat node_modules/.lock-hash 2>/dev/null)\" != \"$h\" ]; then npm ci --no-audit --no-fund && echo \"$h\" > node_modules/.lock-hash; fi; exec npx vite --host 0.0.0.0"]
