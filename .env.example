# Copy to .env (git-ignored). Dev server runs on http://localhost:5174.

# Backend REST API base URL
VITE_API_BASE_URL=http://localhost:8080/api
# Backend origin, used to build /uploads/... image and document URLs
VITE_BASE_URL=http://localhost:8080
# STOMP/SockJS endpoint (not yet read: src/hooks/useWebSocket.tsx still hardcodes it)
VITE_WS_BASE_URL=http://localhost:8080/ws

# Google Maps JavaScript API (location picker). Restrict the key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_ID=
